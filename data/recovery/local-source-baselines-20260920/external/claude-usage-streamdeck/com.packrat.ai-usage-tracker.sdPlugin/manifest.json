{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "AI Usage Tracker",
	"Version": "1.0.1.0",
	"Author": "Packrat",
	"Description": "Every AI limit you are burning through, on one key. Claude, ChatGPT, Codex, Cursor, Gemini, Copilot, Grok and Perplexity, live and colour coded.",
	"Category": "AI Usage Tracker",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"UUID": "com.packrat.ai-usage-tracker",
	"Actions": [
		{
			"Name": "AI Usage",
			"UUID": "com.packrat.ai-usage-tracker.monitor",
			"Icon": "imgs/actions/usage/icon",
			"Tooltip": "Show one provider, or all of them at once. Short press: style. Long press: window.",
			"PropertyInspectorPath": "ui/usage.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"TitleAlignment": "middle"
				}
			]
		}
	]
}