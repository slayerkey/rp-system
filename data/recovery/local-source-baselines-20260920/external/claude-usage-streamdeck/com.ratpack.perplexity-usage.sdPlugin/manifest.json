{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Perplexity Usage",
	"Version": "0.1.2.0",
	"Author": "Ratpack",
	"Description": "Know your Perplexity usage at a glance. Live limits, themeable, calm by design.",
	"Category": "Perplexity Usage",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"UUID": "com.ratpack.perplexity-usage",
	"Actions": [
		{
			"Name": "Perplexity Usage",
			"UUID": "com.ratpack.perplexity-usage.monitor",
			"Icon": "imgs/actions/usage/icon",
			"Tooltip": "Show Perplexity usage. Short press: style · Long press: window.",
			"PropertyInspectorPath": "ui/usage.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"TitleAlignment": "middle"
				}
			]
		}
	]
}