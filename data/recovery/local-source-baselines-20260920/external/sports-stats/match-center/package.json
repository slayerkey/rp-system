  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0",
    "@napi-rs/canvas": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
