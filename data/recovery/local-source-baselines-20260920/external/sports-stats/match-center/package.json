{
  "name": "football-team-tracker-streamdeck",
  "version": "1.0.0",
  "description": "Live football scores, league table, lineups, top scorers and match stats on your Stream Deck",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
