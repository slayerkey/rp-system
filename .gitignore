# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*service-account*.json
*credentials*.json

# Local authentication and browser state
.playwright-profile/
**/.playwright-profile/
**/playwright/.auth/
**/.auth/
**/.claude/settings.local.json

# Dependencies and generated output
node_modules/
**/node_modules/
vendor/
artifacts/
out/
*.log

# Generated Stream Deck plugin output
# Auto Queue builds its runtime bundle and bundled profiles into the sdPlugin
# directory. These are release/dev artifacts, not canonical source files.
plugins/claude-auto-queue/com.packrat.claude-auto-queue.sdPlugin/bin/
plugins/claude-auto-queue/com.packrat.claude-auto-queue.sdPlugin/profiles/
# Discord Bridge deterministically generates runtime and icon assets during build.
plugins/discord-bridge/com.packrat.discord-bridge.sdPlugin/bin/
plugins/discord-bridge/com.packrat.discord-bridge.sdPlugin/imgs/
# Audio Manager Pro generates its runtime bundle, UI copy, icons, self-contained
# native helper, and release package locally. Canonical source lives outside these
# generated directories.
plugins/audio-manager-pro/com.packrat.audio-manager-pro.sdPlugin/bin/
plugins/audio-manager-pro/com.packrat.audio-manager-pro.sdPlugin/imgs/
plugins/audio-manager-pro/com.packrat.audio-manager-pro.sdPlugin/ui/
plugins/audio-manager-pro/com.packrat.audio-manager-pro.sdPlugin/native/
plugins/audio-manager-pro/dist/

# Generated XENEON widget outputs
# tools/xeneon/inline.py writes the flattened shipping entry point here.
# The official CORSAIR packager writes transient packages into widgets/.
widgets/*/index.html
widgets/*.icuewidget

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
