{
  "name": "@packrat/windows-settings-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run typecheck && node scripts/assemble.mjs && rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/policy.test.mjs",
    "validate": "node scripts/validate.mjs",
    "backend:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backend-smoke.ps1"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.0",
    "@elgato/prettier-config": "^0.2.5",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "22.13.0",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
