{
  "name": "@packrat/audio-manager-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && rollup -c && node scripts/cleanup-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "native": "dotnet publish native/PackRat.AudioManager.Helper/PackRat.AudioManager.Helper.csproj -c Release -r win-x64 --self-contained true -o com.packrat.audio-manager-pro.sdPlugin/native/win-x64",
    "native:selftest": "com.packrat.audio-manager-pro.sdPlugin\\native\\win-x64\\PackRat.AudioManager.Helper.exe --self-test",
    "validate": "streamdeck validate com.packrat.audio-manager-pro.sdPlugin --no-update-check",
    "pack": "streamdeck pack com.packrat.audio-manager-pro.sdPlugin --no-update-check --force --output dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.0.2"
  }
}
