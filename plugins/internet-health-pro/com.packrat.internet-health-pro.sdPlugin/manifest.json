{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "UUID": "com.packrat.internet-health-pro.health",
      "Name": "Internet Health",
      "Tooltip": "Overall GOOD, DEGRADED, BAD or OFFLINE state with latency and history.",
      "Icon": "imgs/actions/health/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/health/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.packrat.internet-health-pro.latency",
      "Name": "Latency",
      "Tooltip": "Current native latency with an honest ICMP or fallback method label.",
      "Icon": "imgs/actions/latency/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/latency/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.packrat.internet-health-pro.jitter-loss",
      "Name": "Jitter / Loss",
      "Tooltip": "Show rolling jitter or observed probe loss.",
      "Icon": "imgs/actions/jitter-loss/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/jitter-loss/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.packrat.internet-health-pro.outage",
      "Name": "Outage",
      "Tooltip": "Show current uptime, current outage duration, last outage or recent outage count.",
      "Icon": "imgs/actions/outage/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/outage/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.packrat.internet-health-pro.target",
      "Name": "Target Health",
      "Tooltip": "Monitor one user-selected host or service using ICMP, TCP, DNS or HTTPS.",
      "Icon": "imgs/actions/target/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/target/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.packrat.internet-health-pro.speed-test",
      "Name": "Speed Test",
      "Tooltip": "Run a manual warmed adaptive throughput test. Never runs automatically.",
      "Icon": "imgs/actions/speed-test/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/speed-test/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.packrat.internet-health-pro.summary",
      "Name": "Health Summary",
      "Tooltip": "Compact latency, jitter, probe loss and uptime summary.",
      "Icon": "imgs/actions/summary/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/summary/key",
          "ShowTitle": false
        }
      ]
    }
  ],
  "Author": "PackRat",
  "Category": "Internet Health Pro",
  "CategoryIcon": "imgs/category/icon",
  "CodePath": "bin/plugin.js",
  "Description": "Know when your internet is the problem with continuous local latency, jitter, probe-loss, outage and target health monitoring plus manual speed tests.",
  "Icon": "imgs/plugin/icon",
  "Name": "Internet Health Pro",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "PropertyInspectorPath": "ui/inspector.html",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.packrat.internet-health-pro",
  "Version": "1.0.0.0",
  "Profiles": [
    {
      "Name": "profiles/internet-health-dashboard-mk2",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/internet-health-dashboard-xl",
      "DeviceType": 2,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/internet-health-dashboard-plus",
      "DeviceType": 7,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/internet-health-dashboard-neo",
      "DeviceType": 9,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    }
  ]
}
