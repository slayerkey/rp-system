{
  "name": "@packrat/internet-health-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-profiles.mjs && rollup -c",
    "test": "node scripts/build-profiles.mjs && node --test tests/*.test.mjs",
    "check": "npm run test && npm run build && npm run visual:audit",
    "validate": "streamdeck validate com.packrat.internet-health-pro.sdPlugin --no-update-check",
    "pack": "streamdeck pack com.packrat.internet-health-pro.sdPlugin --no-update-check --force --output dist",
    "visual:audit": "node ../../tools/qa/streamdeck-key-visual-audit.mjs com.packrat.internet-health-pro.sdPlugin --require-major-profiles"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.0.2"
  }
}
