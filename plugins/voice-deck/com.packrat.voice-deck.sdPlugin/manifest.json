{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "UUID": "com.packrat.voice-deck.status",
      "Name": "Voice Status",
      "Tooltip": "Current Discord connection, voice channel and member count.",
      "Icon": "imgs/actions/status/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "States": [{ "Image": "imgs/actions/status/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.mute",
      "Name": "Toggle Mute",
      "Tooltip": "Toggle your Discord microphone mute state.",
      "Icon": "imgs/actions/mute/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/mute/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.deafen",
      "Name": "Toggle Deafen",
      "Tooltip": "Toggle your Discord deafen state.",
      "Icon": "imgs/actions/deafen/icon",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/deafen/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.mute-deafen",
      "Name": "Mute + Deafen",
      "Tooltip": "Tap for one voice control and hold for the other.",
      "Icon": "imgs/actions/combined/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/combined/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.channel",
      "Name": "Current Voice Channel",
      "Tooltip": "Show the active server, voice channel and member count.",
      "Icon": "imgs/actions/channel/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/channel/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.member",
      "Name": "Voice Member",
      "Tooltip": "Pin a current voice member to a live Stream Deck key.",
      "Icon": "imgs/actions/member/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/member/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.member-slot",
      "Name": "Dynamic Member Slot",
      "Tooltip": "Automatically show a numbered member from the current voice roster.",
      "Icon": "imgs/actions/member-slot/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/member-slot/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.spotlight",
      "Name": "Speaker Spotlight",
      "Tooltip": "Show the most recently active current speaker.",
      "Icon": "imgs/actions/spotlight/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/spotlight/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.activity",
      "Name": "Voice Activity",
      "Tooltip": "Show how many people are speaking right now.",
      "Icon": "imgs/actions/activity/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/activity/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.member-count",
      "Name": "Voice Member Count",
      "Tooltip": "Show the number of people in your current Discord voice channel.",
      "Icon": "imgs/actions/count/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/count/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.connection",
      "Name": "Discord Connection",
      "Tooltip": "See setup state and start Discord authorization when needed.",
      "Icon": "imgs/actions/connection/icon",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "imgs/actions/connection/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.packrat.voice-deck.navigator",
      "Name": "Voice Navigator",
      "Tooltip": "Browse live voice members on Stream Deck +. Press to mute and touch to deafen.",
      "Icon": "imgs/actions/navigator/icon",
      "Controllers": ["Encoder"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Encoder": {
        "Icon": "imgs/actions/navigator/encoder",
        "layout": "$A1",
        "StackColor": "#2BE86A",
        "TriggerDescription": {
          "Push": "Toggle mute",
          "Rotate": "Browse voice members",
          "Touch": "Toggle deafen"
        }
      },
      "States": [{ "Image": "imgs/actions/navigator/key", "ShowTitle": false }]
    }
  ],
  "Author": "PackRat",
  "Category": "Discord Voice Deck for Stream Deck",
  "CategoryIcon": "imgs/category/icon",
  "CodePath": "bin/plugin.js",
  "Description": "Turn Stream Deck into a live Discord voice console with members, speaking activity, mute, deafen, channel awareness and included dashboards.",
  "Icon": "imgs/plugin/icon",
  "Name": "Discord Voice Deck for Stream Deck",
  "Nodejs": { "Version": "24" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Profiles": [
    { "Name": "profiles/voice-dashboard-mk2", "DeviceType": 0, "Readonly": false, "DontAutoSwitchWhenInstalled": true, "AutoInstall": true },
    { "Name": "profiles/voice-dashboard-xl", "DeviceType": 2, "Readonly": false, "DontAutoSwitchWhenInstalled": true, "AutoInstall": true },
    { "Name": "profiles/voice-dashboard-plus", "DeviceType": 7, "Readonly": false, "DontAutoSwitchWhenInstalled": true, "AutoInstall": true },
    { "Name": "profiles/compact-voice-neo", "DeviceType": 9, "Readonly": false, "DontAutoSwitchWhenInstalled": true, "AutoInstall": true }
  ],
  "PropertyInspectorPath": "ui/inspector.html",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.3" },
  "UUID": "com.packrat.voice-deck",
  "Version": "1.0.0.0"
}
