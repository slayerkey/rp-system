{
  "name": "@packrat/voice-deck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && rollup -c && node scripts/cleanup-build.mjs",
    "test": "node scripts/build-profiles.mjs && node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "validate": "streamdeck validate com.packrat.voice-deck.sdPlugin --no-update-check",
    "pack": "streamdeck pack com.packrat.voice-deck.sdPlugin --no-update-check --force --output dist",
    "host:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/host-audit.ps1",
    "host:audit:static": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/host-audit.ps1 -StaticOnly",
    "host:probe": "node scripts/discord-probe.mjs --require-voice",
    "host:matrix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/discord-client-matrix.ps1",
    "host:review": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/review-all.ps1"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.0.2"
  }
}
