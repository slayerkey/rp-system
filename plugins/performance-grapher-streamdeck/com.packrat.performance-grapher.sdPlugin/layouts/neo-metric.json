      "color": "#F5F7FB",
      "font": {
        "size": 20,
        "weight": 700
      },
      "text-overflow": "ellipsis"
    },
    {
      "type": "text",
      "key": "secondary",
      "rect": [
        111,
        3,
        116,
        13
      ],
      "alignment": "right",
      "color": "#9AA2AF",
      "font": {
        "size": 9,
        "weight": 600
      },
      "text-overflow": "ellipsis"
    },
    {
      "type": "pixmap",
      "key": "sparkline",
