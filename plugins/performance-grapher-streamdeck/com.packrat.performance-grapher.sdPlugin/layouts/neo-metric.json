{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "packrat-performance-metric",
  "controller": "Neo",
  "items": [
    {
      "type": "text",
      "key": "label",
      "rect": [
        5,
        3,
        100,
        13
