{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "UUID": "com.packrat.macro-recorder-lite.record",
      "Name": "Record Keyboard Macro",
      "Tooltip": "Start or stop a short keyboard macro recording.",
      "Icon": "imgs/actions/record/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/record/key",
          "ShowTitle": false
        }
      ],
      "SupportedInKeyLogicActions": false
    },
    {
      "UUID": "com.packrat.macro-recorder-lite.stop",
      "Name": "Stop",
      "Tooltip": "Stop the active recording or playback.",
      "Icon": "imgs/actions/stop/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/stop/key",
          "ShowTitle": false
        }
      ],
      "SupportedInKeyLogicActions": false
    },
    {
      "UUID": "com.packrat.macro-recorder-lite.replay",
      "Name": "Play Keyboard Macro",
      "Tooltip": "Replay the keyboard macro stored on this key.",
      "Icon": "imgs/actions/replay/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/replay/key",
          "ShowTitle": false
        }
      ]
    }
  ],
  "Author": "PackRat",
  "Category": "Macro Recorder Lite",
  "CategoryIcon": "imgs/category/icon",
  "CodePath": "bin/plugin.js",
  "Description": "Record short keyboard macros, then replay them from Stream Deck on Windows.",
  "Icon": "imgs/plugin/icon",
  "Name": "Macro Recorder Lite",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/macro-recorder-lite-starter-mk2",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-lite-starter-mini",
      "DeviceType": 1,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-lite-starter-xl",
      "DeviceType": 2,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-lite-starter-plus",
      "DeviceType": 7,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-lite-starter-neo",
      "DeviceType": 9,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    }
  ],
  "PropertyInspectorPath": "ui/inspector.html",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.packrat.macro-recorder-lite",
  "Version": "1.0.0.0"
}
