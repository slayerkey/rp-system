{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "UUID": "com.packrat.macro-recorder-pro.record",
      "Name": "Record Macro",
      "Tooltip": "Press once to start recording, then press the same key again to save.",
      "Icon": "imgs/actions/record/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/record/key",
          "ShowTitle": false
        }
      ],
      "SupportedInKeyLogicActions": false
    },
    {
      "UUID": "com.packrat.macro-recorder-pro.stop",
      "Name": "Stop",
      "Tooltip": "Stop the active recording or playback immediately.",
      "Icon": "imgs/actions/stop/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/stop/key",
          "ShowTitle": false
        }
      ],
      "SupportedInKeyLogicActions": false
    },
    {
      "UUID": "com.packrat.macro-recorder-pro.replay",
      "Name": "Play Macro",
      "Tooltip": "Play the assigned Macro Library item with optional speed and repeat controls.",
      "Icon": "imgs/actions/replay/icon",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/replay/key",
          "ShowTitle": false
        }
      ],
      "SupportedInKeyLogicActions": false
    }
  ],
  "Author": "PackRat",
  "Category": "Macro Recorder Pro",
  "CategoryIcon": "imgs/category/icon",
  "CodePath": "bin/plugin.js",
  "Description": "Record keyboard and mouse actions once, then replay, edit, loop and reuse them from Stream Deck on Windows.",
  "Icon": "imgs/plugin/icon",
  "Name": "Macro Recorder Pro",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/macro-recorder-pro-starter-mk2",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-pro-starter-mini",
      "DeviceType": 1,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-pro-starter-xl",
      "DeviceType": 2,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-pro-starter-plus",
      "DeviceType": 7,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/macro-recorder-pro-starter-neo",
      "DeviceType": 9,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    }
  ],
  "PropertyInspectorPath": "ui/inspector.html",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.packrat.macro-recorder-pro",
  "Version": "1.0.0.0"
}
