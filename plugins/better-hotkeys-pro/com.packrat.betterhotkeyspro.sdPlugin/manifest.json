	"Category": "Better Hotkeys & Mouse Pro",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Every Better Hotkeys & Mouse action in one plugin: held keys, held mouse buttons, radial wheel select, auto-repeat, mouse drag, scroll, mic controls, and Stream Deck + dials that send hotkeys or the scroll wheel.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
