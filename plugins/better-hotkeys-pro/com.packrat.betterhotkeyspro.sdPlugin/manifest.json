		{
			"Name": "Dial Control",
			"UUID": "com.packrat.betterhotkeyspro.encoderhotkey",
			"Icon": "imgs/actions/encoderhotkey/icon",
			"Tooltip": "Stream Deck + dials only. Turn to send a hotkey or the scroll wheel; push and tap send their own.",
			"PropertyInspectorPath": "ui/encoder-hotkey.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Hotkey or scroll",
					"Push": "Send hotkey",
					"Touch": "Send hotkey"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/encoderhotkey/key",
					"TitleAlignment": "middle"
				}
			]
		}
