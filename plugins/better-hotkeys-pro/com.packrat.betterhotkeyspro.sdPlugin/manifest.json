			"Name": "Hold Key",
			"UUID": "com.packrat.betterhotkeyspro.holdkey",
			"Icon": "imgs/actions/holdkey/icon",
			"Tooltip": "Holds one or more keys down for exactly as long as you hold the Stream Deck key.",
			"PropertyInspectorPath": "ui/hold-key.html",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/holdkey/key",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/actions/holdkey/key_on",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Toggle Key",
			"UUID": "com.packrat.betterhotkeyspro.togglekey",
